LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claims-control-tower-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Local Docker uses mocks by default, so this bucket value is only a placeholder.
S3_BUCKET_DEFAULT=mock-claims-documents

# Local defaults for OpenAI-compatible providers such as Ollama or DeepSeek.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
DOCUMENT_INTELLIGENCE_MODEL=llama3.1:8b
ENABLE_LLM_DOCUMENT_INTELLIGENCE=false
DEFAULT_HITL_REQUIRED=false
